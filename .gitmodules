[submodule ".registry"]
	path = .registry
	url = https://github.com/nenuial/nenuial.r-universe.dev
	branch = HEAD
[submodule "geodata"]
	path = geodata
	url = https://github.com/Nenuial/geodata
[submodule "geographer"]
	path = geographer
	url = https://github.com/Nenuial/geographer
[submodule "geopkg"]
	path = geopkg
	url = https://github.com/Nenuial/geopkg
[submodule "geotools"]
	path = geotools
	url = https://github.com/Nenuial/geotools
[submodule "geovizr"]
	path = geovizr
	url = https://github.com/Nenuial/geovizr
[submodule "ggeo"]
	path = ggeo
	url = https://github.com/Nenuial/ggeo
[submodule "themakart"]
	path = themakart
	url = https://github.com/Nenuial/themakart
